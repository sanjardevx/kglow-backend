<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/order-confirmation.css" />

<body>
  <div class="orders-container">
    <%- include('includes/nav', { active: 'orders' }) %>
    <div class="body-pad">
      <div class="orders-frame">
        <div class="board">
          <div class="orders-table">
            <div class="section-head">
              <div class="section-title">Order Confirmation</div>
            </div>
            <div class="table-scroll">
            <table class="table-data">
              <thead>
                <tr>
                  <th style="width: 4%">#</th>
                  <th style="width: 12%">Customer</th>
                  <th style="width: 11%">Phone</th>
                  <th style="width: 16%">Delivery Address</th>
                  <th style="width: 16%">Items</th>
                  <th style="width: 8%">Total</th>
                  <th style="width: 9%">Payment Proof</th>
                  <th style="width: 12%">Transfer Note</th>
                  <th style="width: 8%">Status</th>
                  <th style="width: 14%">Action</th>
                </tr>
              </thead>
              <tbody>
                <!--  LOOP ORDERS: START  -->
                <% orders.map(function(value, key) { %>
                <tr class="<%= value.orderStatus === 'WAITING_CONFIRMATION' ? 'row-waiting' : '' %>">
                  <td class="cell-soft"><%= key + 1 %></td>
                  <td class="cell-strong"><%= value.memberData[0] ? value.memberData[0].memberNick : '-' %></td>
                  <td class="cell-soft"><%= value.memberData[0] ? value.memberData[0].memberPhone : '-' %></td>
                  <td class="cell-soft"><%= value.deliveryAddress || '-' %></td>
                  <td>
                    <ul class="items-list">
                      <% value.orderItems.map(function(item) { %>
                      <% const product = value.productData.find(function(p) { return String(p._id) === String(item.productId); }); %>
                      <li><%= product ? product.productName : 'Unknown' %> &times; <%= item.itemQuantity %></li>
                      <% }) %>
                    </ul>
                  </td>
                  <td class="cell-strong"><%= value.orderTotal.toLocaleString('en-US') %></td>
                  <td>
                    <% if (value.paymentProof) { %>
                    <a href="/<%= value.paymentProof %>" target="_blank">
                      <img src="/<%= value.paymentProof %>" class="payment-thumb" />
                    </a>
                    <% } else { %>
                    <span class="cell-soft">-</span>
                    <% } %>
                  </td>
                  <td class="cell-soft"><%= value.transferNote || '-' %></td>
                  <td>
                    <span class="status-pill status-<%= value.orderStatus.toLowerCase() %>">
                      <%= value.orderStatus %>
                    </span>
                  </td>
                  <td>
                    <% if (value.orderStatus === 'WAITING_CONFIRMATION') { %>
                    <button class="btn-sm-good confirm-btn" id="confirm-<%= value._id %>" type="button">Confirm</button>
                    <button class="btn-sm-hard reject-btn" id="reject-<%= value._id %>" type="button">Reject</button>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
                <!--  LOOP ORDERS: END  -->
              </tbody>
            </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="text/javascript" src="/js/order-confirmation.js"></script>
</body>

<%- include('includes/footer') %>