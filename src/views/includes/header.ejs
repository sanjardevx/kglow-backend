<!DOCTYPE html>
<html lang="en">
  <head>
    <title>K-Glow Admin</title>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link rel="stylesheet" type="text/css" href="/css/main.css" />
    <link rel="stylesheet" type="text/css" href="/css/ops-console.css" />

    <!-- jQuery, for the selectors and slideToggle the page scripts use. The
         slim build that used to load first had no effects and was replaced by
         this one a few lines later anyway; Bootstrap's JS and Popper went with
         it, since no view uses a Bootstrap plugin or a data-toggle, and its
         CSS followed — main.css carries the reset rules the pages relied on. 3.7.1
         rather than the original 3.3.1, whose .html()/.append() could run
         script hidden in the HTML they were given (CVE-2020-11022/11023). -->
    <script
      src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"
      integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://unpkg.com/axios@1.21.0/dist/axios.min.js"
      integrity="sha384-p5EwRuz37ylAY9QrjGGIs9ngKVaIwppUFSourks9EIRp1CzoIDWoQkXrHxaAUhEB"
      crossorigin="anonymous"
    ></script>
    <script src="/js/main.js"></script>

    <%# A message left by whatever redirected here, as data rather than as a
        script. main.js reads it on load and shows it as a toast. -%>
    <% if (typeof notice !== 'undefined' && notice) { %>
    <script id="admin-notice" type="application/json">
      <%- JSON.stringify(notice).replace(/</g, "\u003c") %>
    </script>
    <% } %>
  </head>
</html>
