<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/signup.css" />

<body>
  <div class="signup-container">
    <form
      onsubmit="return validateSignupForm();"
      action="/admin/signup"
      method="POST"
      enctype="multipart/form-data"
    >
      <div class="signup-frame">
        <div class="signup-top">
          <span>Signup</span>
          <div>Go back <a href="/admin">Home</a></div>
          <p>
            Already signed up?
            <a href="/admin/login">Login</a>
          </p>
        </div>

        <div class="sign-up-frame">
          <label>Username *</label>
          <input
            type="text"
            name="memberNick"
            class="member-nick"
            placeholder="Username"
            value=""
          />
        </div>

        <div class="sign-up-frame">
          <label>Password *</label>
          <div class="password-field">
            <input
              type="password"
              name="memberPassword"
              class="member-password"
              placeholder="Password"
              value=""
            />
            <span class="password-toggle">Show</span>
          </div>
          <p class="field-hint">Use at least 8 characters.</p>
        </div>

        <input name="memberType" value="ADVISOR" hidden />

        <button class="signup-btn btn" name="signup" type="submit">
          Create Account
        </button>
      </div>
    </form>
  </div>

  <script type="text/javascript" src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>