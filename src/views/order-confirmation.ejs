<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/order-confirmation.css" />

<body>
  <div class="orders-container">
    <%- include('includes/nav', { active: 'orders' }) %>
    <div class="body-pad">
      <div class="orders-frame">
        <div class="board">
          <div class="orders-table">
            <div class="section-head">
              <div class="section-title">Order Confirmation</div>
            </div>
            <div class="table-scroll">
              <table class="table-data">
                <thead>
                  <tr>
                    <th style="width: 6%">#</th>
                    <th style="width: 20%">Customer</th>
                    <th style="width: 18%">Phone</th>
                    <th style="width: 16%">Total</th>
                    <th style="width: 16%">Status</th>
                    <th style="width: 14%">Date</th>
                    <th style="width: 12%">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <!--  LOOP ORDERS: START  -->
                  <% orders.map(function(value, key) { %>
                  <tr class="<%= value.orderStatus === 'WAITING_CONFIRMATION' ? 'row-waiting' : '' %>">
                    <td class="cell-soft"><%= key + 1 %></td>
                    <td class="cell-strong"><%= value.memberData[0] ? value.memberData[0].memberNick : '-' %></td>
                    <td class="cell-soft"><%= value.memberData[0] ? value.memberData[0].memberPhone : '-' %></td>
                    <td class="cell-strong">
                      <%= value.orderTotal.toLocaleString('en-US') %>
                      <% if (value.orderDiscount) { %>
                      <span class="sale-chip">&minus;<%= value.orderDiscountPercent %>%</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="status-pill status-<%= value.orderStatus.toLowerCase() %>">
                        <%= value.orderStatus %>
                      </span>
                    </td>
                    <td class="cell-soft"><%= new Date(value.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></td>
                    <td>
                      <button class="btn-outline view-btn" data-order="<%= value._id %>" type="button">View</button>
                    </td>
                  </tr>
                  <% }) %>
                  <!--  LOOP ORDERS: END  -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!--  ORDER DETAIL MODALS  -->
  <% orders.map(function(value) { %>
  <div class="modal-backdrop" id="order-modal-<%= value._id %>">
    <div class="modal-box">
      <div class="title-row">
        <div class="title">Order Detail</div>
        <button class="modal-close" type="button">&times;</button>
      </div>

      <div class="order-detail">
        <div>
          <div class="card">
            <div class="label">Customer</div>
            <div class="name"><%= value.memberData[0] ? value.memberData[0].memberNick : '-' %></div>
            <div class="sub"><%= value.memberData[0] ? value.memberData[0].memberPhone : '-' %></div>
            <div class="sub"><%= value.deliveryAddress || 'No delivery address' %></div>
          </div>

          <div class="card">
            <div class="label">Order items</div>
            <% value.orderItems.map(function(item) { %>
            <% const product = value.productData.find(function(p) { return String(p._id) === String(item.productId); }); %>
            <div class="item-row">
              <span class="n"><%= product ? product.productName : 'Unknown' %></span>
              <span>&times;<%= item.itemQuantity %></span>
            </div>
            <% }) %>
            <div class="total-row">
              <span>Total</span>
              <span><%= value.orderTotal.toLocaleString('en-US') %></span>
            </div>
            <!-- The transferred amount stays the headline figure: it is what
                 gets matched against the bank screenshot, and leading with
                 the pre-discount price is how a valid order gets rejected.
                 The original sits underneath as the explanation. Orders from
                 before the sale existed carry no discount and show nothing. -->
            <% if (value.orderDiscount) { %>
            <div class="total-note">
              <%= value.orderSubtotal.toLocaleString('en-US') %>
              &minus; <%= value.orderDiscountPercent %>%
              (<%= value.orderDiscount.toLocaleString('en-US') %>)
            </div>
            <% } %>
          </div>

          <div class="card">
            <div class="label">Transfer note</div>
            <div class="sub"><%= value.transferNote || 'No note provided' %></div>
          </div>
        </div>

        <div>
          <% var proofList = Array.isArray(value.paymentProof) ? value.paymentProof : (value.paymentProof ? [value.paymentProof] : []); %>
          <% if (proofList.length) { %>
          <div class="card">
            <div class="label"><%= proofList.length > 1 ? 'Payment screenshots' : 'Payment screenshot' %></div>
            <% proofList.forEach(function(proof) { %>
            <img src="/admin/<%= proof %>" class="shot-img" />
            <% }) %>
          </div>
          <% } %>

          <% if (value.orderStatus === 'WAITING_CONFIRMATION') { %>
          <div class="decision-row" id="decision-<%= value._id %>">
            <button class="btn-console confirm-btn" id="confirm-<%= value._id %>" type="button">Confirm</button>
            <button class="btn-text-danger reject-btn" id="reject-<%= value._id %>" type="button">Reject</button>
          </div>

          <!-- Opens in place of the buttons rather than as a second modal on
               top of this one — the reason is part of rejecting, not a
               separate decision. -->
          <div class="reject-box" id="reject-box-<%= value._id %>">
            <label>Why is this order being rejected?</label>
            <textarea
              class="reject-reason-input"
              rows="3"
              placeholder="e.g. The payment screenshot doesn't match the order total."
            ></textarea>
            <div class="reject-box-actions">
              <button class="btn-outline reject-cancel" type="button" data-order="<%= value._id %>">Cancel</button>
              <button class="btn-text-danger reject-submit" type="button" data-order="<%= value._id %>">Reject order</button>
            </div>
          </div>
          <% } %>

          <% if (value.orderStatus === 'REJECTED' && value.rejectReason) { %>
          <div class="card">
            <div class="label">Rejection reason</div>
            <div class="sub"><%= value.rejectReason %></div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <% }) %>

  <script type="text/javascript" src="/js/order-confirmation.js"></script>
</body>

<%- include('includes/footer') %>