<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/products.css" />

<body>
  <div class="products-container">
    <%- include('includes/nav', { active: 'products' }) %>
    <div class="body-pad">
      <div class="restaurant-menu-frame">
        <div class="board">
          <div class="dishes-table">
            <div class="section-head">
              <div class="section-title">Products</div>
              <button class="btn-console" id="process-btn" type="button">+ New Product</button>
            </div>
            <div class="table-scroll">
            <table class="table-data">
              <thead>
                <tr>
                  <th style="width: 5%">#</th>
                  <th style="width: 8%"></th>
                  <th style="width: 24%">Name</th>
                  <th style="width: 14%">Brand</th>
                  <th style="width: 12%">Category</th>
                  <th style="width: 8%">Volume</th>
                  <th style="width: 10%">Price</th>
                  <th style="width: 6%">Left</th>
                  <th style="width: 10%">Status</th>
                  <th style="width: 7%"></th>
                </tr>
              </thead>
              <tbody>
                <!--  LOOP PRODUCTS: START  -->
                <% products.map(function(value, key) { %>
                <tr>
                  <td class="cell-soft"><%= key + 1 %></td>
                  <td>
                    <% if (value.productImages && value.productImages[0]) { %>
                    <img src="/<%= value.productImages[0] %>" class="thumb-sm" />
                    <% } else { %>
                    <div class="thumb-sm"></div>
                    <% } %>
                  </td>
                  <td class="cell-strong"><%= value.productName %></td>
                  <td class="cell-soft"><%= value.productBrand %></td>
                  <td class="cell-soft"><%= value.productCategory %></td>
                  <td class="cell-soft"><%= /^[\d.]+$/.test(value.productVolume) ? value.productVolume + ' ml' : value.productVolume %></td>
                  <td class="cell-strong"><%= value.productPrice.toLocaleString('en-US') %></td>
                  <td class="cell-soft"><%= value.productLeftCount %></td>
                  <td>
                    <select
                      class="status-select status-<%= value.productStatus.toLowerCase() %> new-product-status"
                      id="<%= value._id %>"
                    >
                      <option value="PAUSE"
                        <%= value.productStatus === 'PAUSE' ? 'selected' : '' %> >Pause</option>
                      <option value="PROCESS"
                        <%= value.productStatus === 'PROCESS' ? 'selected' : '' %> >Process</option>
                      <option value="DELETE"
                        <%= value.productStatus === 'DELETE' ? 'selected' : '' %> >Delete</option>
                    </select>
                  </td>
                  <td>
                    <button
                      class="btn-outline product-edit-btn"
                      type="button"
                      data-id="<%= value._id %>"
                      aria-label="Edit"
                      title="Edit"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                    </button>
                  </td>
                </tr>
                <% }) %>
                <!--  LOOP PRODUCTS: END  -->
              </tbody>
            </table>
            </div>
          </div>
          <form
            onsubmit="return validateForm()"
            action="/admin/product/create"
            method="POST"
            class="dish-container"
            enctype="multipart/form-data"
          >
            <div class="long-input" style="display: flex; align-items: center">
              <span class="new-dish-txt">NEW PRODUCT DETAIL</span>
            </div>
            <div class="login-input-frame">
              <div class="long-input">
                <label>Product Name</label>
                <input
                  type="text"
                  placeholder="Name"
                  name="productName"
                  class="product-name"
                />
              </div>
              <input
                name="productStatus"
                value="PROCESS"
                class="product-status"
                hidden
              />
            </div>
            <div class="half-input-frame">
              <div class="half-input">
                <label>Product Price</label>
                <input
                  type="number"
                  placeholder="Price"
                  name="productPrice"
                  class="product-price"
                />
              </div>
              <div class="half-input">
                <label>Product Left Counts</label>
                <input
                  type="number"
                  placeholder="Counts"
                  name="productLeftCount"
                  class="product-left-count"
                />
              </div>
            </div>

            <div class="half-input-frame">
              <div class="half-input">
                <label>Product Brand</label>
                <input type="text" placeholder="e.g. COSRX" name="productBrand" class="product-brand" />
              </div>
              <div class="half-input">
                <label>Product Category</label>
                <select class="product-category" name="productCategory">
                  <option value="SKINCARE" selected>Skincare</option>
                  <option value="MAKEUP">Makeup</option>
                  <option value="SETS">Sets</option>
                </select>
              </div>
            </div>

            <div class="long-input">
              <label>Product Volume</label>
              <input type="text" placeholder="e.g. 50ml" name="productVolume" class="product-volume" />
            </div>
            <div class="long-input">
              <label>Product Description</label>
              <textarea name="productDesc" class="product-desc"></textarea>
            </div>
            <div class="long-input">
              <label>How to Use</label>
              <textarea name="productHowToUse" class="product-howtouse"></textarea>
            </div>
            <div class="long-input">
              <label>Suitable For</label>
              <input type="text" placeholder="e.g. All, Oily, Sensitive" name="productSuitableFor" class="product-suitablefor" />
            </div>

            <div class="img-frame">
              <label>Product Images</label>
              <div class="media-frame">
                <div class="upload-img-box">
                  <img src="/img/upload.svg" class="1" id="image-section-1" />
                  <input
                    type="file"
                    name="productImages"
                    class="image-one"
                    required
                    onchange="previewFileHandler(this, 1)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/img/upload.svg" class="2" id="image-section-2" />
                  <input
                    type="file"
                    name="productImages"
                    class="image-two"
                    onchange="previewFileHandler(this, 2)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/img/upload.svg" class="3" id="image-section-3" />
                  <input
                    type="file"
                    name="productImages"
                    class="image-three"
                    onchange="previewFileHandler(this, 3)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/img/upload.svg" class="4" id="image-section-4" />
                  <input
                    type="file"
                    name="productImages"
                    class="image-four"
                    onchange="previewFileHandler(this, 4)"
                  />
                </div>
                <div class="upload-img-box">
                  <img src="/img/upload.svg" class="5" id="image-section-5" />
                  <input
                    type="file"
                    name="productImages"
                    class="image-five"
                    onchange="previewFileHandler(this, 5)"
                  />
                </div>
              </div>
            </div>

            <div class="operation-buttons">
              <button class="btn-text-danger" id="cancel-btn" type="button">Cancel</button>
              <button type="submit" class="btn-console" id="create-btn">
                Create
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- One shared drawer, filled in by JS from the JSON block below — the
       table stays visible beside it, so the admin never loses their place.
       A per-row overlay isn't an option here: absolutely-positioned boxes
       inside <tr>/<td> don't lay out reliably. -->
  <div class="drawer-backdrop" id="drawer-backdrop"></div>
  <aside class="product-drawer" id="product-drawer">
    <div class="drawer-head">
      <span class="drawer-title">Edit product</span>
      <button class="drawer-close" id="drawer-close" type="button" aria-label="Close">&times;</button>
    </div>

    <div class="drawer-body">
      <div class="drawer-field">
        <label>Images <span class="label-hint">(the first one is the main photo)</span></label>
        <div class="drawer-media" id="drawer-media"></div>
      </div>

      <div class="drawer-field">
        <label>Name</label>
        <input type="text" id="edit-name" />
      </div>

      <div class="drawer-row">
        <div class="drawer-field">
          <label>Brand</label>
          <input type="text" id="edit-brand" />
        </div>
        <div class="drawer-field">
          <label>Category</label>
          <select id="edit-category">
            <option value="SKINCARE">Skincare</option>
            <option value="MAKEUP">Makeup</option>
            <option value="SETS">Sets</option>
          </select>
        </div>
      </div>

      <div class="drawer-row">
        <div class="drawer-field">
          <label>Volume</label>
          <input type="text" id="edit-volume" placeholder="e.g. 50ml" />
        </div>
        <div class="drawer-field">
          <label>Status</label>
          <select id="edit-status">
            <option value="PAUSE">Pause</option>
            <option value="PROCESS">Process</option>
            <option value="DELETE">Delete</option>
          </select>
        </div>
      </div>

      <div class="drawer-row">
        <div class="drawer-field">
          <label>Price</label>
          <input type="number" min="0" id="edit-price" />
        </div>
        <div class="drawer-field">
          <label>Left</label>
          <input type="number" min="0" id="edit-left" />
        </div>
      </div>
    </div>

    <div class="drawer-foot">
      <button class="btn-outline" id="drawer-cancel" type="button">Cancel</button>
      <button class="btn-console" id="drawer-save" type="button">Save</button>
    </div>
  </aside>

  <!-- `<` is escaped so a product name containing "</script>" can't close
       this block early. -->
  <script id="products-data" type="application/json">
    <%- JSON.stringify(products).replace(/</g, "\\u003c") %>
  </script>

  <script type="text/javascript" src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>