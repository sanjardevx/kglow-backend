<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>
  <div class="users-container">
    <% if(!member) { %>
    <%- include('includes/nav', { active: 'users' }) %>
    <div class="body-pad">
      <div class="users-frame" style="color: #dddddd">
        <div class="board" style="font-size: 40px">Please login first!</div>
      </div>
    </div>

    <% } else { %>
    <%- include('includes/nav', { active: 'users' }) %>
    <div class="body-pad">
      <div class="users-frame">
        <div class="board">
          <div class="user-table">
            <div class="section-head">
              <div class="section-title">Users</div>
            </div>
            <div class="table-scroll">
              <table class="table-data">
                <thead>
                  <tr>
                    <th style="width: 8%">#</th>
                    <th style="width: 40%">Name</th>
                    <th style="width: 32%">Phone</th>
                    <th style="width: 20%">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <!--  LOOP USERS: START  -->
                  <% users.map(function(value, index) { %>
                  <tr>
                    <td class="cell-soft"><%= index+1 %></td>
                    <td class="cell-strong"><%= value.memberNick %></td>
                    <td class="cell-soft"><%= value.memberPhone %></td>
                    <td>
                      <select class="status-select status-<%= value.memberStatus.toLowerCase() %> member-status" id="<%= value._id %>">
                        <option value="ACTIVE" <%= value.memberStatus === 'ACTIVE' ? 'selected': '' %>>Active</option>
                        <option value="BLOCK" <%= value.memberStatus === 'BLOCK' ? 'selected': '' %>>Block</option>
                        <option value="DELETE" <%= value.memberStatus === 'DELETE' ? 'selected': '' %>>Delete</option>
                      </select>
                    </td>
                  </tr>
                  <% }) %>
                  <!--  LOOP USERS: END  -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>