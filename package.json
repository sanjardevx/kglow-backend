{
  "name": "kglow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API and admin panel for K-Glow Secrets, an online shop for Korean skincare in Uzbekistan",
  "homepage": "https://www.kglowshop.uz",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanjardev23/kglow-backend.git"
  },
  "author": "Sanjar Kurbonaliyev",
  "license": "UNLICENSED",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc && node -e \"for (const d of ['views','public']) require('fs').cpSync('src/'+d, 'dist/'+d, { recursive: true })\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@sentry/node": "^11.10.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "connect-mongodb-session": "^3.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "ejs": "^3.1.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^6.13.12",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/connect-mongodb-session": "^2.4.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.3",
    "@types/express-serve-static-core": "^4.19.8",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14"
    }
  }
}
