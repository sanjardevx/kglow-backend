<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/tutorials.css" />

<body>
  <div class="tutorials-container">
    <%- include('includes/nav', { active: 'tutorials' }) %>
    <div class="body-pad">
      <div class="tutorials-frame">
        <div class="board">
          <div class="section-head">
            <div class="section-title">Live Tutorials</div>
            <button class="btn-console" id="process-btn" type="button">+ New Tutorial</button>
          </div>

          <!-- Sits right under the button (not after the grid) so it opens
               in the same spot no matter how many reels have piled up
               below — otherwise "+ New Tutorial" pushes further and
               further down the page as the grid grows. -->
          <form
            onsubmit="return validateTutorialForm()"
            action="/admin/tutorial/create"
            method="POST"
            class="tutorial-container"
          >
            <div class="long-input" style="display: flex; align-items: center">
              <span class="new-tutorial-txt">NEW TUTORIAL</span>
            </div>

            <div class="long-input">
              <label>Video link (YouTube or Instagram)</label>
              <input
                type="text"
                placeholder="https://www.youtube.com/shorts/... or https://www.instagram.com/reel/..."
                name="tutorialUrl"
                id="tutorial-url-input"
                autocomplete="off"
              />
            </div>

            <!-- Live preview — fills in as soon as the pasted link is
                 recognised, no separate "Preview" step. -->
            <div class="tutorial-url-preview" id="tutorial-url-preview"></div>

            <div class="long-input">
              <label>Title</label>
              <input type="text" placeholder="e.g. Morning routine with Dokdo Toner" name="tutorialTitle" id="tutorial-title-input" />
            </div>

            <div class="operation-buttons">
              <button class="btn-outline" id="cancel-btn" type="button">Cancel</button>
              <button type="submit" class="btn-console" id="create-btn">
                Upload
              </button>
            </div>
          </form>

          <!--  LOOP TUTORIALS: START  -->
          <div class="tutorial-grid">
            <% tutorials.map(function(value) { %>
            <div class="tutorial-card" id="card-<%= value._id %>">
              <div class="tutorial-embed">
                <% if (value.tutorialPlatform === 'YOUTUBE' && value.tutorialThumbnail) { %>
                <!-- Click-to-play: no iframe on the page until the admin
                     actually wants to watch it, so YouTube's title/channel
                     overlay (shown on a live-but-paused player, and not
                     something any embed parameter can suppress — `showinfo`
                     was removed by YouTube in 2018) never appears here. Our
                     own thumbnail + play button stand in for it. -->
                <button
                  type="button"
                  class="tutorial-play-btn"
                  data-embed-id="<%= value.tutorialEmbedId %>"
                  data-title="<%= value.tutorialTitle %>"
                  aria-label="Play video"
                >
                  <img src="<%= value.tutorialThumbnail %>" alt="" class="tutorial-thumb" />
                  <span class="tutorial-play-icon">▶</span>
                </button>
                <% } else if (value.tutorialPlatform === 'YOUTUBE') { %>
                <iframe
                  src="https://www.youtube.com/embed/<%= value.tutorialEmbedId %>?rel=0&modestbranding=1&iv_load_policy=3"
                  title="<%= value.tutorialTitle %>"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
                <% } else { %>
                <blockquote
                  class="instagram-media"
                  data-instgrm-permalink="<%= value.tutorialUrl %>"
                  data-instgrm-version="14"
                ></blockquote>
                <% } %>
              </div>

              <div class="tutorial-body">
                <div class="tutorial-title"><%= value.tutorialTitle %></div>
              </div>

              <div class="tutorial-toolbar">
                <div class="tutorial-status-wrap status-<%= value.tutorialStatus.toLowerCase() %>">
                  <span class="tutorial-status-dot"></span>
                  <select class="tutorial-status" id="<%= value._id %>">
                    <option value="ACTIVE" <%= value.tutorialStatus === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                    <option value="HIDDEN" <%= value.tutorialStatus === 'HIDDEN' ? 'selected' : '' %>>Hidden</option>
                  </select>
                </div>

                <button class="btn-outline tutorial-edit-btn" type="button" data-id="<%= value._id %>">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                  Edit
                </button>
                <button
                  class="btn-text-danger tutorial-delete-btn"
                  type="button"
                  data-id="<%= value._id %>"
                  aria-label="Delete"
                  title="Delete"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                </button>
              </div>

              <!-- Per-card edit overlay — covers only this card
                   (.tutorial-card is its position:relative parent), so
                   opening it can never touch any other card in the grid. -->
              <div class="tutorial-edit-overlay" id="tutorial-edit-overlay-<%= value._id %>">
                <div class="tutorial-edit-overlay-head">
                  <div class="tutorial-edit-overlay-head-left">
                    <span class="tutorial-edit-overlay-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                    </span>
                    <span class="title">Edit</span>
                  </div>
                  <button class="tutorial-edit-overlay-close" type="button" data-id="<%= value._id %>" aria-label="Close">&times;</button>
                </div>

                <div class="tutorial-edit-overlay-fields">
                  <div>
                    <label>Title</label>
                    <input type="text" class="edit-title" value="<%= value.tutorialTitle %>" />
                  </div>
                  <div>
                    <label>Video link</label>
                    <input type="text" class="edit-url" value="<%= value.tutorialUrl %>" />
                  </div>
                  <div>
                    <label>Status</label>
                    <select class="edit-status">
                      <option value="ACTIVE" <%= value.tutorialStatus === 'ACTIVE' ? 'selected' : '' %>>Active</option>
                      <option value="HIDDEN" <%= value.tutorialStatus === 'HIDDEN' ? 'selected' : '' %>>Hidden</option>
                    </select>
                  </div>
                </div>

                <div class="operation-buttons">
                  <button class="btn-outline tutorial-edit-cancel" type="button" data-id="<%= value._id %>">Cancel</button>
                  <button class="btn-console tutorial-edit-save" type="button" data-id="<%= value._id %>">Save</button>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
          <!--  LOOP TUTORIALS: END  -->
        </div>
      </div>
    </div>
  </div>

  <script async src="//www.instagram.com/embed.js"></script>
  <script src="https://www.youtube.com/iframe_api"></script>
  <script type="text/javascript" src="/js/tutorials.js"></script>
</body>

<%- include('includes/footer') %>
